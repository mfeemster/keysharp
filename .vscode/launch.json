{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: Keysharp",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Keysharp",
            "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0/Keysharp.dll",
            "args": ["${workspaceFolder}/Keysharp.Tests/Code/Gui/guitest.ks"],
            "cwd": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0",
            "osx": {
                "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0/Keysharp.app/Contents/MacOS/Keysharp"
            },
            "windows": {
                "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0-windows/Keysharp.exe",
                "cwd": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0-windows"
            },
            "console": "internalConsole",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "C#: Keyview",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Keyview",
            "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0/Keyview.dll",
            "args": [],
            "cwd": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0",
            "osx": {
                "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0/Keyview.app/Contents/MacOS/Keyview"
            },
            "windows": {
                "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0-windows/Keyview.exe",
                "cwd": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0-windows"
            },
            "console": "internalConsole",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "C#: Keysharp.OutputTest",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Keysharp.OutputTest (AnyCPU)",
            "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0/Keysharp.OutputTest.dll",
            "args": [],
            "cwd": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0",
            "osx": {
                "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0/Keysharp.OutputTest.app/Contents/MacOS/Keysharp.OutputTest"
            },
            "windows": {
                "program": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0-windows/Keysharp.OutputTest.exe",
                "cwd": "${workspaceFolder}/bin/${config:keysharp.buildConfiguration}/net10.0-windows"
            },
            "console": "internalConsole",
            "stopAtEntry": false,
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
