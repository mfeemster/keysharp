<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFramework>net10.0-windows</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup>
		<AssemblyName>Keysharp.Components.Packages.NuGet</AssemblyName>
		<RootNamespace>Keysharp.Components.Packages.NuGet</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<OutputPath>$(BaseOutputPath)$(Configuration)/$(TargetFramework)/components/packages/nuget/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Contracts/Keysharp.Components.Packages.csproj" Private="false" />
		<PackageReference Include="NuGet.Commands" Version="7.9.0" />
		<PackageReference Include="NuGet.Credentials" Version="7.9.0" />
		<!-- Override NuGet.Packaging's vulnerable transitive dependency. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" GeneratePathProperty="true" />
		<None Update="provider.json" CopyToOutputDirectory="Always" />
		<_ProviderPayloadName Include="Keysharp.Components.Packages.NuGet.dll;
			Keysharp.Components.Packages.NuGet.deps.json;
			Microsoft.Extensions.FileSystemGlobbing.dll;
			Newtonsoft.Json.dll;
			NuGet.Commands.dll;
			NuGet.Common.dll;
			NuGet.Configuration.dll;
			NuGet.Credentials.dll;
			NuGet.DependencyResolver.Core.dll;
			NuGet.Frameworks.dll;
			NuGet.LibraryModel.dll;
			NuGet.Packaging.dll;
			NuGet.ProjectModel.dll;
			NuGet.Protocol.dll;
			NuGet.Versioning.dll;
			System.Security.Cryptography.Pkcs.dll;
			provider.json" />
	</ItemGroup>
	<Target Name="ValidateProviderPayload" AfterTargets="Build">
		<!-- Keep the Windows implementation after RID-specific payload directories are removed. -->
		<Copy SourceFiles="$(PkgSystem_Security_Cryptography_Pkcs)/runtimes/win/lib/net10.0/System.Security.Cryptography.Pkcs.dll"
		      DestinationFolder="$(TargetDir)" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
		<ItemGroup>
			<_ProviderPayload Include="@(_ProviderPayloadName->'$(TargetDir)%(Identity)')" />
			<_ProviderActual Include="$(TargetDir)**\*" />
			<_ProviderUnexpected Include="@(_ProviderActual)" Exclude="@(_ProviderPayload)" />
		</ItemGroup>
		<Delete Files="@(_ProviderUnexpected)" />
		<RemoveDir Directories="$(TargetDir)runtimes" Condition="Exists('$(TargetDir)runtimes')" />
		<Error Condition="!Exists('%(_ProviderPayload.Identity)')" Text="NuGet provider payload is missing %(_ProviderPayload.Filename)%(_ProviderPayload.Extension)." />
	</Target>

	<Target Name="GetComponentPayload" DependsOnTargets="Build" Returns="@(_ComponentPayload)">
		<ItemGroup>
			<_ComponentPayload Include="@(_ProviderPayloadName->'$(TargetDir)%(Identity)')">
				<ComponentRelativePath>components\packages\nuget\%(Filename)%(Extension)</ComponentRelativePath>
				<!-- Providers load on demand, so their assemblies remain IL. -->
				<PostprocessAssembly>false</PostprocessAssembly>
			</_ComponentPayload>
		</ItemGroup>
	</Target>
</Project>
